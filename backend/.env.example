# Copy to .env and fill in your real Gemini API key.
# Get one at: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=AQ.Ab8RN6K7iTVSOfuIrJjli6QZoIfFrZHVxHZ4JYWgmaHsbuPizw

# Flash is the cheap/fast default — swap to gemini-2.0-pro or similar if
# generation quality needs to go up and cost is less of a concern.
GEMINI_GENERATION_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_MAX_OUTPUT_TOKENS=8192

# Token-optimization knobs — see app/testcase_generator.py for how these
# are used in the RAG pipeline.
CHUNK_SIZE_CHARS=1800
CHUNK_OVERLAP_CHARS=200
RETRIEVAL_TOP_K=6

MAX_UPLOAD_SIZE_MB=20
